[build-system]
requires = ["setuptools>=61"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_slug }}-pdca-harness"
version = "0.1.0"
description = "PDCA quality-cycle harness for {{ project_name }}"
requires-python = ">=3.11"
{% if author_name -%}
authors = [{ name = "{{ author_name }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }]
{% endif -%}
dependencies = []

[project.scripts]
pdca = "pdca_harness.cli:main"

[tool.setuptools.packages.find]
where = ["src"]
