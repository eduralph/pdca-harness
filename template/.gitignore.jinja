# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Claude — machine-local permissions/paths, never publish (any depth, incl. bundles)
settings.local.json
**/.claude/settings.local.json

# Runtime / generated artifacts (regenerable)
.rehearse/
results/issue_selftest/
*.log

# Oversized interactive-leaf seeds spilled to a scratch file (leaves._seed_positional,
# issue #313). Every interactive leaf runs with the PROJECT ROOT as its cwd, so the spill
# lands here rather than in a bundle — and the Act seed, the one that actually overflows,
# is ~150 KB. Normally unlinked when the session ends; a killed session orphans one, which
# is the other reason this line exists. Keep the pattern in step with
# `leaves._SEED_SPILL_PREFIX` (a test asserts they match).
.pdca-prompt-*.md

# Interactive-leaf exit-contract session state (handoff.session, issue #331) — the
# driver's scratch channel (act-log baseline, /handoff pass record, abandon reason),
# created in the project root and removed when the driver reaps the session; a killed
# session can orphan one. Keep the pattern in step with `handoff.STATE_PREFIX`
# (a test asserts they match).
.pdca-handoff-*.json

# Act frontier lock/temp sidecars (issue #299) — runtime-only serialization helpers;
# the marker itself ({{ process_dir }}/.act-reviewed) stays tracked.
.act-reviewed.lock
.act-reviewed.tmp.*
.act-session.lock

# Per-cycle Do/Check worktrees (issue #94) — created next to the target checkout;
# ignored in case a checkout lives inside the project tree.
*.pdca-wt/
*.pdca-wt-l*/
